# ncraft server configuration (copy to `.env` or export before launch).

# TCP port the combined HTTP + WebSocket server listens on.
PORT=8080
HOST=0.0.0.0

# World seed. Same seed + same edits == identical world for every node.
WNCRAFT_SEED=1337

# Where the world edits are persisted (must be writable).
WNCRAFT_DATA=./data
